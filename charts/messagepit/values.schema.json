{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "MessagePit uses an in-memory single inbox and must run as one replica."
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "uiPort", "sendgridPort", "extraPorts"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "uiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sendgridPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "port", "targetPort"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "targetPort": {
                "oneOf": [
                  { "type": "integer", "minimum": 1, "maximum": 65535 },
                  { "type": "string", "minLength": 1 }
                ]
              },
              "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] }
            }
          }
        }
      }
    },
    "messagepit": {
      "type": "object",
      "required": ["twilioIngest"],
      "properties": {
        "twilioIngest": {
          "type": "object",
          "required": ["enabled", "port"],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "sidecars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "image"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "minLength": 1 }
        }
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "existingSecret": { "type": "string" },
    "retention": {
      "type": "object",
      "required": ["maxAge", "maxMessages"],
      "properties": {
        "maxAge": { "type": "string", "pattern": "^[1-9][0-9]*[hd]$" },
        "maxMessages": { "type": "integer", "minimum": 1 }
      }
    },
    "storage": {
      "type": "object",
      "required": ["sizeLimit"],
      "properties": {
        "sizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressFrom"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" }
      }
    }
  },
  "required": ["replicaCount", "image", "service", "messagepit", "sidecars", "extraVolumes", "retention", "storage"]
}
